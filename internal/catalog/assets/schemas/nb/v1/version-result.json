{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nb/v1/version-result",
  "type": "object",
  "required": ["schema", "ok", "operation", "data"],
  "properties": {
    "schema": {"const": "nb/v1/version-result"},
    "ok": {"const": true},
    "operation": {"const": "version"},
    "data": {
      "type": "object",
      "required": ["version", "commit", "date"],
      "properties": {
        "version": {"type": "string"},
        "commit": {"type": "string"},
        "date": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
