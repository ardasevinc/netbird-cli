{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nb/v1/networks-get-result",
  "type": "object",
  "required": ["schema", "ok", "operation", "data"],
  "properties": {"schema": {"const": "nb/v1/networks-get-result"}, "ok": {"const": true}, "operation": {"const": "networks.get"}, "data": {"type": "object", "required": ["network", "completeness"], "properties": {"network": {"$ref": "#/$defs/network"}, "completeness": {"$ref": "#/$defs/completeness"}}, "additionalProperties": false}},
  "$defs": {"network": {"type": "object", "required": ["id", "name", "policies", "resources", "routers", "routing_peers_count"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": ["string", "null"]}, "policies": {"type": "array", "items": {"type": "string"}}, "resources": {"type": "array", "items": {"type": "string"}}, "routers": {"type": "array", "items": {"type": "string"}}, "routing_peers_count": {"type": "integer"}}, "additionalProperties": false}, "completeness": {"type": "object", "required": ["state"], "properties": {"state": {"const": "complete"}, "reason": {"type": ["string", "null"]}}, "additionalProperties": false}},
  "additionalProperties": false
}
