{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nb/v1/apply-result",
  "type": "object",
  "required": ["schema", "ok", "operation", "data"],
  "properties": {
    "schema": {"const": "nb/v1/apply-result"},
    "ok": {"const": true},
    "operation": {"const": "apply"},
    "data": {
      "type": "object",
      "required": ["stage_id", "revision", "state"],
      "properties": {
        "stage_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "attempt_id": {"type": "string"},
        "state": {"enum": ["already_satisfied", "confirmed_success"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
