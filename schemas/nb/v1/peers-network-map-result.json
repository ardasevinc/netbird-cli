{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nb/v1/peers-network-map-result",
  "type": "object",
  "required": ["schema", "ok", "operation", "data"],
  "properties": {
    "schema": {"const": "nb/v1/peers-network-map-result"},
    "ok": {"const": true},
    "operation": {"const": "peers.network_map"},
    "data": {
      "type": "object",
      "required": ["peer_id", "peers", "completeness"],
      "properties": {
        "peer_id": {"type": "string"},
        "peers": {"type": "array", "items": {"type": "object"}},
        "completeness": {"$ref": "#/$defs/completeness"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "completeness": {
      "type": "object",
      "required": ["state"],
      "properties": {"state": {"const": "complete"}, "reason": {"type": ["string", "null"]}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
